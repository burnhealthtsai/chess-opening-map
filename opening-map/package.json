{
  "name": "chess-opening-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:data": "node scripts/build-map-data.mjs && node scripts/split-puzzle-catalog.mjs",
    "generate:puzzle-catalog": "node scripts/split-puzzle-catalog.mjs",
    "generate:puzzles": "node scripts/export-notion-puzzles.mjs && node scripts/refresh-puzzle-solutions.mjs && node scripts/split-puzzle-catalog.mjs",
    "generate:engine": "node scripts/copy-stockfish.mjs",
    "dev": "pnpm generate:data && vite",
    "typecheck": "tsc --noEmit",
    "test": "pnpm generate:puzzle-catalog && node --test scripts/*.test.mjs",
    "build": "pnpm generate:data && pnpm generate:engine && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.1.1",
    "chess.js": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.0",
    "vite": "^6.4.3"
  }
}
